plt.title("Daily Return Distributions")
plt.xlabel("Daily Return")
plt.ylabel("Density")
plt.xlim(-0.10, 0.10)
plt.show()


# =============================================================================
# 18. ANNUALIZED VOLATILITY BY STOCK
# =============================================================================
# Volatility is measured using the standard deviation of daily returns.
#
# Annualized Volatility = daily standard deviation * sqrt(252)
#
# Benchmarks are excluded so this chart compares individual stocks.

stock_volatility = (
    market_data[
        market_data["Sector"] != "Benchmark"
    ]
    .groupby("Ticker")["Daily_Return"]
    .std() * np.sqrt(252)
).dropna().sort_values(ascending=False)

plt.figure(figsize=(18, 7))
sns.barplot(x=stock_volatility.index, y=stock_volatility.values)
plt.xticks(rotation=90)
plt.title("Annualized Volatility by Stock")
plt.xlabel("Ticker")
plt.ylabel("Annualized Volatility")
plt.tight_layout()
plt.show()


# =============================================================================
# 19. 21-DAY ROLLING ANNUALIZED VOLATILITY
# =============================================================================
# Calculate volatility over a moving window of 21 trading days.
# This is approximately one trading month.
#
# Rolling_Volatility = 21-day standard deviation * sqrt(252)
#
# This chart shows how volatility changes over time rather than displaying
# only one volatility number for the entire period.

rolling_stocks = ["AAPL", "MSFT", "SPY", "AMZN", "XOM"]

fig, axes = plt.subplots(
    len(rolling_stocks),
    1,
    figsize=(15, 15),
    sharex=True
)

for ax, ticker in zip(axes, rolling_stocks):
    df = market_data[
        market_data["Ticker"] == ticker
    ].copy()

    df["Rolling_Volatility"] = (
        df["Daily_Return"]
        .rolling(21)
        .std() * np.sqrt(252)
    )

    ax.plot(df["Date"], df["Rolling_Volatility"])
    ax.set_title(f"{ticker}: 21-Day Rolling Volatility")
    ax.set_ylabel("Annualized Volatility")

plt.xlabel("Date")
plt.tight_layout()
plt.show()


# =============================================================================
# 20. CORRELATION BETWEEN STOCK DAILY RETURNS
# =============================================================================
# Convert the long-format dataset into a wide-format return matrix.
#
# Rows    = trading dates
# Columns = ticker symbols
# Values  = daily returns
#
# Pearson correlation ranges from -1 to +1:
# +1 = perfectly positive linear relationship
#  0 = no linear correlation
# -1 = perfectly negative linear relationship
#
# min_periods=100 requires at least 100 paired observations.
# Correlation describes co-movement; it does not establish causation.

return_matrix = market_data.pivot(
    index="Date",
    columns="Ticker",
    values="Daily_Return"
)

stock_matrix = return_matrix.drop(
    columns=benchmarks,
    errors="ignore"
)

correlation_matrix = stock_matrix.corr(min_periods=100)

plt.figure(figsize=(18, 14))
sns.heatmap(
    correlation_matrix,
    cmap="coolwarm",
    center=0,
    vmin=-1,
    vmax=1,
    linewidths=0.1
)
plt.title("Stock Daily Return Correlation Matrix")
plt.tight_layout()
plt.show()


# =============================================================================
# 21. AVERAGE CORRELATION WITHIN EACH SECTOR
# =============================================================================
# For each sector:
# 1. Select the stocks in that sector.
# 2. Calculate their pairwise return correlations.
# 3. Keep only the upper triangle to avoid counting pairs twice.
# 4. Calculate the average pairwise correlation.
#
# sector_corr_df contains:
# Sector = sector name
# Average_Correlation = average pairwise correlation

sector_correlations = {}

for sector, stocks in sector_universes.items():
    available = [
        ticker for ticker in stocks
        if ticker in stock_matrix.columns
    ]

    if len(available) < 2:
        continue

    sector_corr = stock_matrix[available].corr()

    upper_triangle = sector_corr.where(
        np.triu(
            np.ones(sector_corr.shape),
            k=1
        ).astype(bool)
    )

    sector_correlations[sector] = upper_triangle.stack().mean()

sector_corr_df = pd.DataFrame({
    "Sector": list(sector_correlations.keys()),
    "Average_Correlation": list(sector_correlations.values())
}).sort_values("Average_Correlation", ascending=False)

display(sector_corr_df)

plt.figure(figsize=(13, 7))
sns.barplot(
    data=sector_corr_df,
    x="Average_Correlation",
    y="Sector"
)
plt.title("Average Within-Sector Stock Correlation")
plt.show()


# =============================================================================
# 22. DAILY TRADING VOLUME
# =============================================================================
# Volume represents the number of shares traded during a trading day.
# This section plots daily volume for selected stocks and one benchmark.
#
# Volume counts shares traded, not dollar turnover.

volume_stocks = ["AAPL", "MSFT", "SPY", "AMZN"]

fig, axes = plt.subplots(2, 2, figsize=(16, 10))

for ax, ticker in zip(axes.flatten(), volume_stocks):
    df = market_data[
        market_data["Ticker"] == ticker
    ]

    ax.plot(df["Date"], df["Volume"], linewidth=0.8)
    ax.set_title(f"{ticker}: Daily Trading Volume")
    ax.set_ylabel("Shares Traded")
    ax.set_xlabel("Date")

plt.tight_layout()
plt.show()


# =============================================================================
# 23. RELATIVE VOLUME
# =============================================================================
# Calculate the average volume over the previous 20 trading observations.
#
# Average_Volume_20 = 20-day rolling average of volume
# Relative_Volume = current volume / 20-day average volume
#
# Relative volume interpretation:
# Above 1 = volume is above its recent average
# Equal to 1 = volume equals its recent average
# Below 1 = volume is below its recent average
#
# The first 19 observations generally have missing rolling averages.

market_data["Average_Volume_20"] = (
    market_data.groupby("Ticker")["Volume"]
    .transform(lambda values: values.rolling(20).mean())
)

market_data["Relative_Volume"] = (
    market_data["Volume"] /
    market_data["Average_Volume_20"]
)

aapl_volume = market_data[
    market_data["Ticker"] == "AAPL"
]

plt.figure(figsize=(15, 6))
plt.plot(
    aapl_volume["Date"],
    aapl_volume["Relative_Volume"]
)
plt.axhline(1, linestyle="--", color="black")
plt.title("AAPL Relative Trading Volume")
plt.xlabel("Date")
plt.ylabel("Volume / 20-Day Average")
plt.show()


# =============================================================================
# 24. EQUAL-WEIGHTED SECTOR PERFORMANCE
# =============================================================================
# Exclude benchmark ETFs and calculate the average daily stock return
# for each sector.
#
# Sector_Return = average daily return across stocks in that sector
# Sector_Growth = 1 + Sector_Return
# Cumulative_Return = compounded growth of an initial $1
#
# This is a simple equal-weighted sector proxy, not an official sector index.

stock_data = market_data[
    market_data["Sector"] != "Benchmark"
].copy()

sector_daily_returns = (
    stock_data.groupby(["Date", "Sector"])["Daily_Return"]
    .mean()
    .reset_index(name="Sector_Return")
)

sector_daily_returns = sector_daily_returns.dropna()

sector_daily_returns["Sector_Growth"] = (
    1 + sector_daily_returns["Sector_Return"]
)

sector_daily_returns["Cumulative_Return"] = (
    sector_daily_returns.groupby("Sector")["Sector_Growth"]
    .cumprod()
)

plt.figure(figsize=(16, 8))
sns.lineplot(
    data=sector_daily_returns,
    x="Date",
    y="Cumulative_Return",
    hue="Sector"
)
plt.title("Equal-Weighted Sector Performance (2010-2015)")
plt.xlabel("Date")
plt.ylabel("Growth of $1")
plt.legend(bbox_to_anchor=(1.02, 1), loc="upper left")
plt.tight_layout()
plt.show()


# =============================================================================
# 25. ANNUALIZED VOLATILITY BY SECTOR
# =============================================================================
# Calculate the standard deviation of each sector's daily return series.
#
# Annualized sector volatility = daily standard deviation * sqrt(252)
#
# This compares the historical volatility of the selected sectors.

sector_volatility = (
    sector_daily_returns.groupby("Sector")["Sector_Return"]
    .std() * np.sqrt(252)
).sort_values(ascending=False)

plt.figure(figsize=(13, 7))
sns.barplot(
    x=sector_volatility.values,
    y=sector_volatility.index
)
plt.title("Annualized Volatility by Sector")
plt.xlabel("Annualized Volatility")
plt.ylabel("Sector")
plt.show()


# =============================================================================
# 26. ANNUAL STOCK RETURNS
# =============================================================================
# For each ticker and calendar year, find the first and last adjusted closing
# prices in the downloaded observations.
#
# Annual_Return = last adjusted close / first adjusted close - 1
#
# annual_returns is a long-format DataFrame.
# annual_pivot is a wide-format DataFrame:
# Rows = tickers
# Columns = years
# Values = annual returns
#
# This uses the first and last available observations within each year.

annual_returns = (
    market_data
    .groupby(
        ["Ticker", pd.Grouper(key="Date", freq="YE")]
    )["Adj Close"]
    .agg(["first", "last"])
    .reset_index()
)

annual_returns["Annual_Return"] = (
    annual_returns["last"] /
    annual_returns["first"] - 1
)

annual_returns["Year"] = annual_returns["Date"].dt.year

annual_pivot = annual_returns.pivot(
    index="Ticker",
    columns="Year",
    values="Annual_Return"
)

display(annual_pivot.round(4))

plt.figure(figsize=(13, 12))
sns.heatmap(
    annual_pivot,
    cmap="RdYlGn",
    center=0,
    annot=False
)
plt.title("Annual Stock Returns: 2010-2015")
plt.xlabel("Year")
plt.ylabel("Ticker")
plt.show()


