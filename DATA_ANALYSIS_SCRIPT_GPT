
# =============================================================================
# US EQUITY MARKET DATA: EXPLORATORY DATA ANALYSIS (2010-2015)
# =============================================================================
#
# PROJECT OVERVIEW
# Downloads daily historical market data for selected US stocks and four
# market benchmarks, cleans and combines the data, calculates returns,
# performs exploratory analysis, creates visualizations, and exports datasets.
#
# DATA PERIOD: January 1, 2010 - December 31, 2015
#
# DATA SOURCE: Yahoo Finance (through yfinance)
#
# IMPORTANT:
# This is historical descriptive analysis, not a trading recommendation.
# Returns use Adjusted Close to account for adjustments represented in Yahoo's
# historical data.
# =============================================================================


# =============================================================================
# 1. INSTALLATION AND IMPORTS
# =============================================================================
# In Google Colab, uncomment and run this line if packages are not installed.
#
# !pip install -q yfinance pandas numpy matplotlib seaborn plotly scipy pyarrow
#
# Libraries:
# yfinance  = downloads historical stock market data
# pandas    = organizes and analyzes tabular data
# numpy     = numerical calculations
# matplotlib = creates charts
# seaborn   = creates statistical visualizations
# plotly    = interactive visualization library
# scipy     = statistical functions

import yfinance as yf
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import plotly.express as px
import plotly.graph_objects as go

from datetime import datetime
from scipy import stats


# =============================================================================
# 2. GLOBAL CONFIGURATION
# =============================================================================
# Define the date range and general chart settings.
# END_DATE is exclusive, so January 1, 2016 includes data through 2015-12-31.

START_DATE = "2010-01-01"
END_DATE = "2016-01-01"

sns.set_theme(style="whitegrid")
plt.rcParams["figure.figsize"] = (14, 6)

pd.set_option("display.max_columns", 30)
pd.set_option("display.width", 150)

print("Environment initialized.")
print(f"Analysis period: {START_DATE} to 2015-12-31")


# =============================================================================
# 3. DEFINE STOCK UNIVERSE AND MARKET BENCHMARKS
# =============================================================================
# Each list contains stock ticker symbols.
# Stocks are grouped into 11 broad industry sectors.
#
# A ticker is the short symbol used to identify a publicly traded security.
# sector_universes is a dictionary mapping sector names to ticker lists.
#
# This is a manually selected research universe, not every company in each
# sector or a historical index constituent list.

technology = [
    "AAPL", "MSFT", "GOOGL", "GOOG", "IBM",
    "ORCL", "INTC", "CSCO", "QCOM", "TXN",
    "AVGO", "ADBE", "CRM", "AMAT", "MU"
]

financials = [
    "JPM", "BAC", "WFC", "C", "GS",
    "MS", "BLK", "SCHW", "AXP", "USB"
]

healthcare = [
    "JNJ", "PFE", "MRK", "ABBV", "UNH",
    "CVS", "ABT", "MDT", "BMY", "GILD"
]

consumer_discretionary = [
    "AMZN", "HD", "MCD", "NKE", "SBUX",
    "LOW", "TGT", "BKNG", "F", "GM"
]

consumer_staples = [
    "WMT", "COST", "KO", "PEP", "PG",
    "CL", "KHC", "GIS"
]

energy = [
    "XOM", "CVX", "COP", "SLB", "EOG",
    "OXY", "PSX", "MPC"
]

industrials = [
    "GE", "CAT", "BA", "HON", "UPS",
    "FDX", "DE", "LMT", "MMM"
]

materials = [
    "LIN", "APD", "SHW", "NEM", "FCX",
    "NUE", "DOW"
]

utilities = [
    "NEE", "DUK", "SO", "AEP", "EXC"
]

real_estate = [
    "AMT", "PLD", "SPG", "O", "EQIX"
]

communication_services = [
    "META", "NFLX", "DIS", "CMCSA", "VZ",
    "T", "TMUS"
]

sector_universes = {
    "Technology": technology,
    "Financials": financials,
    "Healthcare": healthcare,
    "Consumer Discretionary": consumer_discretionary,
    "Consumer Staples": consumer_staples,
    "Energy": energy,
    "Industrials": industrials,
    "Materials": materials,
    "Utilities": utilities,
    "Real Estate": real_estate,
    "Communication Services": communication_services
}

# Combine all sector lists into one sorted list.
# set() removes duplicate ticker symbols.
tickers = sorted(set(
    ticker
    for sector in sector_universes.values()
    for ticker in sector
))

# Market benchmarks:
# SPY = S&P 500 ETF
# QQQ = Nasdaq-100 ETF
# IWM = Russell 2000 ETF
# DIA = Dow Jones Industrial Average ETF

benchmarks = ["SPY", "QQQ", "IWM", "DIA"]

# Combine individual stocks and benchmarks for downloading.
download_tickers = tickers + benchmarks

print("Number of stocks:", len(tickers))
print("Number of sectors:", len(sector_universes))
print("Number of benchmarks:", len(benchmarks))
print("Total tickers to download:", len(download_tickers))

for sector, stocks in sector_universes.items():
    print(f"{sector}: {len(stocks)} stocks")


# =============================================================================
# 4. DOWNLOAD DAILY HISTORICAL MARKET DATA
# =============================================================================
# Download daily data for every ticker using Yahoo Finance.
#
# Data fields generally include:
# Open       = opening price
# High       = highest price during the trading day
# Low        = lowest price during the trading day
# Close      = unadjusted closing price
# Adj Close  = adjusted closing price
# Volume     = number of shares traded
# Dividends  = dividend payments recorded for that date
# Stock Splits = stock split information
#
# data is a dictionary:
# Key   = ticker symbol
# Value = pandas DataFrame containing that ticker's daily data
#
# failed_tickers records symbols that could not be downloaded.

data = {}
failed_tickers = []

for ticker in download_tickers:
    try:
        df = yf.download(
            ticker,
            start=START_DATE,
            end=END_DATE,
            interval="1d",
            auto_adjust=False,
            actions=True,
            repair=True,
            progress=False,
            threads=False
        )

        if df.empty:
            failed_tickers.append(ticker)
            print(f"FAILED: {ticker} - No data returned")
            continue

        # Newer yfinance versions may return MultiIndex columns.
        # Flatten these into ordinary column names.
        if isinstance(df.columns, pd.MultiIndex):
            if ticker in df.columns.get_level_values(-1):
                df = df.xs(ticker, axis=1, level=-1)
            elif ticker in df.columns.get_level_values(0):
                df = df.xs(ticker, axis=1, level=0)
            else:
                df.columns = df.columns.get_level_values(0)

        # Remove duplicate column names if they exist.
        df = df.loc[:, ~df.columns.duplicated()]

        data[ticker] = df
        print(f"Downloaded {ticker}: {len(df)} rows")

    except Exception as error:
        failed_tickers.append(ticker)
        print(f"ERROR: {ticker} - {error}")

print("\nDOWNLOAD SUMMARY")
print("----------------")
print("Successful:", len(data))
print("Failed:", len(failed_tickers))
print("Failed tickers:", failed_tickers)

if not data:
    raise RuntimeError(
        "No ticker data was downloaded. Check the internet connection, "
        "Yahoo Finance availability, and ticker symbols."
    )


# =============================================================================
# 5. INSPECT RAW DATA FOR ONE STOCK
# =============================================================================
# Inspect AAPL as an example of the raw downloaded data.
# If AAPL is unavailable, inspect the first successfully downloaded ticker.

inspection_ticker = "AAPL" if "AAPL" in data else next(iter(data))

print(f"\nExample raw data: {inspection_ticker}")
display(data[inspection_ticker].head(10))

print("\nDataset information:")
data[inspection_ticker].info()

print("\nColumn names:")
print(data[inspection_ticker].columns.tolist())

print("\nDate range:")
print(data[inspection_ticker].index.min())
print(data[inspection_ticker].index.max())


# =============================================================================
# 6. COMBINE ALL TICKERS INTO ONE DATAFRAME
# =============================================================================
# Originally, each ticker has its own DataFrame inside the data dictionary.
# This section combines them into one large table.
#
# Each row represents one ticker on one trading date.
#
# Added columns:
# Ticker = stock or ETF symbol
# Date   = trading date
#
# market_data is the main dataset used throughout the analysis.

frames = []

for ticker, df in data.items():
    temp = df.copy()
    temp["Ticker"] = ticker
    temp["Date"] = temp.index
    frames.append(temp)

market_data = pd.concat(frames, ignore_index=True)
market_data["Date"] = pd.to_datetime(market_data["Date"])

# Sort observations chronologically for each ticker.
market_data = market_data.sort_values(
    ["Ticker", "Date"]
).reset_index(drop=True)

print("Dataset dimensions (rows, columns):", market_data.shape)
display(market_data.head(10))


# =============================================================================
# 7. ASSIGN EACH TICKER TO ITS SECTOR
# =============================================================================
# Create a dictionary that maps each ticker to its industry sector.
# Add a Sector column to the main dataset.
#
# Benchmark ETFs are assigned the label "Benchmark".

sector_mapping = {
    ticker: sector
    for sector, stocks in sector_universes.items()
    for ticker in stocks
}

market_data["Sector"] = market_data["Ticker"].map(sector_mapping)

market_data.loc[
    market_data["Ticker"].isin(benchmarks),
    "Sector"
] = "Benchmark"

display(
    market_data[
        ["Date", "Ticker", "Sector", "Close", "Volume"]
    ].head(15)
)

print("\nSector distribution (unique ticker count):")
print(market_data.groupby("Sector")["Ticker"].nunique())


# =============================================================================
# 8. MISSING VALUE ANALYSIS
# =============================================================================
# Check how many values are missing in each column.
#
# Missing Count = number of missing cells
# Missing Percentage = percentage of rows missing that field
#
# NaN represents a missing or unavailable value.

missing_report = pd.DataFrame({
    "Missing Count": market_data.isnull().sum(),
    "Missing Percentage": market_data.isnull().mean() * 100
})

display(
    missing_report.sort_values(
        "Missing Percentage",
        ascending=False
    )
)


# =============================================================================
# 9. DATA COVERAGE AND MISSING PRICES BY TICKER
# =============================================================================
# Calculate data availability for every ticker.
#
# Observations   = number of daily rows available
# First_Date     = first available date
# Last_Date      = last available date
# Missing_Close  = missing closing prices
# Missing_Volume = missing trading volume values
# Coverage_Percentage = ticker observations relative to total unique dates
#
# This helps identify stocks with shorter or incomplete data histories.

ticker_quality = market_data.groupby("Ticker").agg(
    Observations=("Date", "count"),
    First_Date=("Date", "min"),
    Last_Date=("Date", "max"),
    Missing_Close=("Close", lambda values: values.isna().sum()),
    Missing_Volume=("Volume", lambda values: values.isna().sum())
)

ticker_quality["Coverage_Percentage"] = (
    ticker_quality["Observations"] /
    market_data["Date"].nunique() * 100
)

display(
    ticker_quality.sort_values(
        "Coverage_Percentage",
        ascending=True
    )
)


# =============================================================================
# 10. CHECK FOR DUPLICATE TICKER-DATE OBSERVATIONS
# =============================================================================
# Check whether the same ticker has more than one row for the same date.
# Duplicate observations can distort calculations and counts.

duplicate_count = market_data.duplicated(
    subset=["Date", "Ticker"]
).sum()

print("Duplicate observations:", duplicate_count)
print("Unique tickers:", market_data["Ticker"].nunique())
print("Unique trading dates:", market_data["Date"].nunique())

print("\nOverall date range:")
print("Start:", market_data["Date"].min())
print("End:", market_data["Date"].max())


# =============================================================================
# 11. NUMBER OF OBSERVATIONS PER STOCK
# =============================================================================
# Count the number of daily observations available for each ticker.
#
# observations is a pandas Series:
# Index = ticker symbol
# Value = number of observations
#
# The bar chart makes it easier to identify stocks with shorter histories.

observations = (
    market_data.groupby("Ticker")
    .size()
    .sort_values(ascending=False)
)

plt.figure(figsize=(18, 7))
sns.barplot(x=observations.index, y=observations.values)
plt.xticks(rotation=90)
plt.title("Historical Observations Per Stock")
plt.xlabel("Ticker")
plt.ylabel("Number of Daily Observations")
plt.tight_layout()
plt.show()


# =============================================================================
# 12. CALCULATE DAILY AND LOG RETURNS
# =============================================================================
# Calculate daily percentage returns using Adjusted Close.
#
# Daily_Return = (Today's Adjusted Close / Yesterday's Adjusted Close) - 1
#
# Log_Return = ln(Today's Adjusted Close / Yesterday's Adjusted Close)
#
# Both are decimal returns:
# 0.01  = approximately +1%
# -0.02 = approximately -2%
#
# The first observation for each ticker has no previous price, so its return
# is NaN. groupby ensures each ticker is calculated independently.

market_data = market_data.sort_values(
    ["Ticker", "Date"]
).copy()

market_data["Daily_Return"] = (
    market_data.groupby("Ticker")["Adj Close"]
    .pct_change(fill_method=None)
)

market_data["Log_Return"] = np.log(
    market_data["Adj Close"] /
    market_data.groupby("Ticker")["Adj Close"].shift(1)
)

display(
    market_data[
        ["Date", "Ticker", "Adj Close", "Daily_Return", "Log_Return"]
    ].head(15)
)


# =============================================================================
# 13. CALCULATE EXCESS RETURNS RELATIVE TO SPY
# =============================================================================
# SPY is used as the S&P 500 benchmark.
#
# SPY_Return = daily return of SPY
# Excess_Return = ticker's Daily_Return - SPY_Return
#
# Positive excess return means the ticker outperformed SPY that day.
# Negative excess return means the ticker underperformed SPY that day.
#
# This is a simple benchmark-relative return, not a risk-adjusted alpha model.

spy_returns = (
    market_data[
        market_data["Ticker"] == "SPY"
    ][["Date", "Daily_Return"]]
    .rename(columns={"Daily_Return": "SPY_Return"})
)

market_data = market_data.merge(
    spy_returns,
    on="Date",
    how="left"
)

market_data["Excess_Return"] = (
    market_data["Daily_Return"] - market_data["SPY_Return"]
)

display(
    market_data[
        ["Date", "Ticker", "Daily_Return", "SPY_Return", "Excess_Return"]
    ].head(15)
)


# =============================================================================
# 14. SUMMARY STATISTICS FOR DAILY RETURNS
# =============================================================================
# Calculate descriptive statistics for each ticker's daily returns.
#
# Observations             = number of non-missing returns
# Mean_Return              = average daily return
# Median_Return            = median daily return
# Std_Return               = standard deviation of daily returns
# Min_Return               = smallest daily return
# Max_Return               = largest daily return
# Skewness                 = asymmetry of return distribution
# Kurtosis                 = tail-weight measure
# Annualized_Mean_Return   = average daily return multiplied by 252
# Annualized_Volatility    = daily standard deviation multiplied by sqrt(252)
#
# 252 is the approximate number of US trading days in one year.

return_summary = market_data.groupby("Ticker").agg(
    Observations=("Daily_Return", "count"),
    Mean_Return=("Daily_Return", "mean"),
    Median_Return=("Daily_Return", "median"),
    Std_Return=("Daily_Return", "std"),
    Min_Return=("Daily_Return", "min"),
    Max_Return=("Daily_Return", "max"),
    Skewness=("Daily_Return", "skew"),
    Kurtosis=("Daily_Return", lambda values: values.kurtosis())
)

return_summary["Annualized_Mean_Return"] = (
    return_summary["Mean_Return"] * 252
)

return_summary["Annualized_Volatility"] = (
    return_summary["Std_Return"] * np.sqrt(252)
)

return_summary = return_summary.sort_values(
    "Annualized_Mean_Return",
    ascending=False
)

display(return_summary.round(4))


# =============================================================================
# 15. COMPARE MARKET BENCHMARK PERFORMANCE
# =============================================================================
# Compare SPY, QQQ, IWM, and DIA.
#
# Normalized_Price = Adjusted Close / first Adjusted Close * 100
#
# Each benchmark starts at 100, making their relative performance easier
# to compare even though their original share prices differ.

benchmark_data = market_data[
    market_data["Ticker"].isin(benchmarks)
].copy()

benchmark_data["Normalized_Price"] = (
    benchmark_data.groupby("Ticker")["Adj Close"]
    .transform(lambda values: values / values.dropna().iloc[0] * 100)
)

plt.figure(figsize=(16, 8))
sns.lineplot(
    data=benchmark_data,
    x="Date",
    y="Normalized_Price",
    hue="Ticker"
)
plt.title("Benchmark Performance: 2010-2015")
plt.xlabel("Date")
plt.ylabel("Normalized Adjusted Price (Base = 100)")
plt.legend(title="Benchmark")
plt.show()


# =============================================================================
# 16. COMPARE SELECTED STOCK PERFORMANCE
# =============================================================================
# Select a sample of stocks from different sectors.
# Normalize their adjusted prices to a starting value of 100.

selected_stocks = [
    "AAPL", "MSFT", "JPM", "XOM",
    "JNJ", "AMZN", "KO", "CAT"
]

selected_data = market_data[
    market_data["Ticker"].isin(selected_stocks)
